+// Wega contributors, 2026: host-owned storage without profile paths in content.
+/// The embedder supplies an origin-bound backend before untrusted script runs.
+pub trait StorageBackend: Send + Sync {
+  fn call(&self, persistent: bool, operation: &str, key: &str, value: &str, index: u32) -> Result<String, String>;
+}
+pub fn set_backend(state: &mut OpState, backend: std::sync::Arc<dyn StorageBackend>) {
+  state.put(backend);
+}
+fn backend<T: serde::de::DeserializeOwned>(state: &OpState, persistent: bool, operation: &str, key: &str, value: &str, index: u32) -> Option<Result<T, WebStorageError>> {
+  state.try_borrow::<std::sync::Arc<dyn StorageBackend>>().map(|backend| {
+    let reply = backend.call(persistent, operation, key, value, index).map_err(|error| if error.starts_with("QuotaExceededError:") { WebStorageError::BrokerQuota } else { WebStorageError::Broker(error) })?;
+    serde_json::from_str(&reply).map_err(|error| WebStorageError::Broker(error.to_string()))
+  })
 }
 
