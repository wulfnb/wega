<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Wega Third-Party Notices</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; line-height: 1.5; max-width: 960px; margin: 0 auto; padding: 24px 16px; color: #0f172a; background: #ffffff; }
    h1, h2, h3 { line-height: 1.25; }
    pre { white-space: pre-wrap; background: #f1f5f9; padding: 12px; border-radius: 6px; font-size: .85rem; overflow-wrap: anywhere; }
    .license { border-top: 1px solid #cbd5e1; padding-top: 12px; margin-top: 24px; }
    ul.used-by { columns: 2; font-size: .9rem; }
    @media (max-width: 640px) { ul.used-by { columns: 1; } }
  </style>
</head>
